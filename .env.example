APP_NAME="TaskHub API"
DEBUG=True
API_V1_STR="/api/v1"

# SQLite async (mac dinh chay local)
DATABASE_URL="sqlite+aiosqlite:///./taskhub.db"

# MySQL 8 async:
# DATABASE_URL="mysql+aiomysql://root:password@localhost:3306/taskhub"

# PostgreSQL 16 async:
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/taskhub"

# JWT settings
JWT_SECRET_KEY="change-this-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Caching
REDIS_URL="redis://localhost:6379/0"
CACHE_ENABLED=true
